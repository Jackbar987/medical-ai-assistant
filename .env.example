# Example settings file.
#
# 1. Make a copy of this file and name the copy ".env"
# 2. Replace the placeholder values in ".env" with your real ones
#
# The real ".env" file is listed in .gitignore, so it is never uploaded to
# GitHub. This example file IS uploaded, so it must only ever contain
# placeholders, never real keys or passwords.

# Set to 1 while developing (auto-reload and detailed error pages).
# Set to 0, or remove the line, on any public deployment.
FLASK_DEBUG=1

# The port the local server listens on.
# If port 5000 is already in use on your computer, try 5001.
PORT=5000

# API key for the AI provider. Not used yet: we choose a provider and add
# the real key in Phase 3. The variable name may change at that point.
AI_API_KEY=your-api-key-here
